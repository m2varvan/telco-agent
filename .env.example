# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real keys.

# ── NVIDIA NIM — Nemotron Telco ──────────────────────────────────────────────
LLM_MODEL_NAME=nvidia/llama-3.3-nemotron-super-49b-v1
LLM_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Frontier Model — GPT-5.4 ───────────────────────────────────────────────
FRONTIER_MODEL_NAME=gpt-5.4
FRONTIER_API_KEY=your-frontier-key-here
FRONTIER_BASE_URL=https://vscode-models.services.ai.azure.com/openai/v1

# ── Frontier Model — Claude Opus via Azure AI Foundry ────────────────────────
FRONTIER_MODEL_NAME_2=your-opus-deployment-name
FRONTIER_API_KEY_2=your-frontier-key-here
FRONTIER_BASE_URL_2=https://your-resource.services.ai.azure.com/anthropic

# ── Open-source Model — OpenTel 2.0 via OpenAI-compatible endpoint ───────────
LLM_MODEL_NAME_2=farbodtavakkoli--otel-20-llm-31b-it
LLM_API_KEY_2=your-api-key-here
LLM_BASE_URL_2=https://your-endpoint/openai/v1

# ── Active model (nemotron_nim, gpt_5_4, opus_4_7, or otel_2_0) ─────────────
ACTIVE_LLM=nemotron_nim

# ── Data paths (defaults shown — override if CSVs live elsewhere) ─────────────
LTE_KPI_CSV=sample_data/lte_kpi_sample.csv
NR_ENDC_CSV=sample_data/nr_endc_sample.csv
CM_CONFIG_CSV=sample_data/cm_config_sample.csv
ALARM_HISTORY_CSV=sample_data/alarm_history.csv
