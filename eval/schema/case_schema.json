{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCA Test Case",
  "description": "Schema for a single RCA evaluation test case per the evaluation plan Section 11.",
  "type": "object",
  "required": ["case_id", "family", "difficulty", "incident", "ground_truth"],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique case identifier. Format: F{N}_{DEV|TEST}_{NNN}",
      "pattern": "^F[1-5]_(DEV|TEST)_[0-9]{3}$"
    },
    "family": {
      "type": "string",
      "enum": ["config_change", "outage", "interference", "endc", "ambiguous"],
      "description": "Incident scenario family."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard", "ambiguous"],
      "description": "Difficulty tier for this case."
    },
    "incident": {
      "type": "object",
      "required": ["target_cell", "incident_time", "description"],
      "properties": {
        "target_cell": {
          "type": "string",
          "description": "Primary cell identifier for this incident."
        },
        "incident_time": {
          "type": "string",
          "description": "ISO-8601 timestamp of the incident."
        },
        "description": {
          "type": "string",
          "description": "Natural-language incident description sent to the agent."
        }
      },
      "additionalProperties": false
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "root_cause_code",
        "acceptable_root_cause_codes",
        "required_tools",
        "optional_tools",
        "required_evidence",
        "needs_further_investigation"
      ],
      "properties": {
        "root_cause_code": {
          "type": "string",
          "enum": [
            "CELL_BARRED_CHANGE",
            "ADMIN_STATE_CHANGE",
            "BANDWIDTH_CHANGE",
            "POWER_CONFIG_CHANGE",
            "BACKHAUL_LINK_DOWN",
            "POWER_FAILURE",
            "NEIGHBOUR_INTERFERENCE",
            "NR_RANDOM_ACCESS_FAILURE",
            "UNDETERMINED"
          ]
        },
        "acceptable_root_cause_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CELL_BARRED_CHANGE",
              "ADMIN_STATE_CHANGE",
              "BANDWIDTH_CHANGE",
              "POWER_CONFIG_CHANGE",
              "BACKHAUL_LINK_DOWN",
              "POWER_FAILURE",
              "NEIGHBOUR_INTERFERENCE",
              "NR_RANDOM_ACCESS_FAILURE",
              "UNDETERMINED"
            ]
          },
          "description": "All root-cause codes that receive partial credit (includes the primary code)."
        },
        "required_tools": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Tools the agent must call to earn full score."
        },
        "optional_tools": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Tools that are acceptable but not required."
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": {"type": "string"},
              "table": {"type": "string"},
              "field": {"type": "string"},
              "metric": {"type": "string"}
            },
            "additionalProperties": false
          },
          "description": "Evidence items the agent must cite for full evidence recall."
        },
        "needs_further_investigation": {
          "type": "boolean",
          "description": "Expected value of needs_further_investigation in the agent output."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
