{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCA Agent Output",
  "description": "Structured output schema for the Network Incident Triage Agent RCA response.",
  "type": "object",
  "required": [
    "incident_id",
    "root_cause_code",
    "root_cause",
    "evidence",
    "confidence",
    "needs_further_investigation",
    "recommended_next_step"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Unique identifier for the incident or test case, e.g. F1_DEV_001"
    },
    "root_cause_code": {
      "type": "string",
      "description": "Machine-readable canonical root cause code from the RCA taxonomy.",
      "enum": [
        "CELL_BARRED_CHANGE",
        "ADMIN_STATE_CHANGE",
        "BANDWIDTH_CHANGE",
        "POWER_CONFIG_CHANGE",
        "BACKHAUL_LINK_DOWN",
        "POWER_FAILURE",
        "NEIGHBOUR_INTERFERENCE",
        "NR_RANDOM_ACCESS_FAILURE",
        "UNDETERMINED"
      ]
    },
    "root_cause": {
      "type": "string",
      "description": "Human-readable root cause statement (max 200 characters).",
      "maxLength": 200
    },
    "alternative_hypotheses": {
      "type": "array",
      "description": "Ranked list of alternative hypotheses the agent considered.",
      "items": {
        "type": "object",
        "required": ["cause", "probability"],
        "properties": {
          "cause": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "description": "List of evidence items the agent collected and used.",
      "items": {
        "type": "object",
        "required": ["source", "observation"],
        "properties": {
          "source": {
            "type": "string",
            "description": "Data domain: KPI, CM, Alarm, NR"
          },
          "table": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "needs_further_investigation": {
      "type": "boolean"
    },
    "recommended_next_step": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
